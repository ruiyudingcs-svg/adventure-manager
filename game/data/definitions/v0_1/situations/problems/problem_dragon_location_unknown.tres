[sub_resource type="Resource" id="Resource_8wreb"]
script = ExtResource("3_7v1ac")
type = &"phase_is"
target_id = &"phase_open_conflict"

[sub_resource type="Resource" id="Resource_wfqja"]
script = ExtResource("5_75ubu")
id = &"urgency_capture_research_delayed"
