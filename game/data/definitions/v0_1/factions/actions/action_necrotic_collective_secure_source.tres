[gd_resource type="Resource" script_class="FactionActionDefinitionResource" format=3]

[ext_resource type="Script" path="res://game/data/definitions/situations/world_condition_resource.gd" id="1_ewmwp"]
[ext_resource type="Script" path="res://game/data/definitions/contracts/world_effect_resource.gd" id="2_nkpbe"]
[ext_resource type="Script" path="res://game/data/definitions/factions/faction_action_definition_resource.gd" id="3_6s3if"]

[sub_resource type="Resource" id="Resource_8ngre"]
script = ExtResource("1_ewmwp")
type = &"problem_is_active"
target_id = &"problem_necrotic_spread"

[sub_resource type="Resource" id="Resource_wo2bh"]
script = ExtResource("2_nkpbe")
