[resource]
script = ExtResource("4_emk36")
id = &"problem_evacuating_civilians"
title_key = &"problem.problem_evacuating_civilians.title"
description_key = &"problem.problem_evacuating_civilians.description"
problem_tags = Array[StringName]([&"civilian_evacuation", &"defensive_line"])
base_urgency = 45
age_urgency_per_week = 6
age_urgency_cap = 18
response_window_weeks = 4
urgency_rules = Array[ExtResource("5_ihx6k")]([SubResource("Resource_w8r74"), SubResource("Resource_vpwsr")])
activation_rules = Array[ExtResource("1_2oerd")]([SubResource("Resource_ror53"), SubResource("Resource_ug7hv")])
resolution_rules = Array[ExtResource("1_2oerd")]([SubResource("Resource_8n0c1"), SubResource("Resource_lhu1y")])
related_clock_ids = Array[StringName]([&"villagers_evacuated", &"settlement_destruction", &"necrotic_corruption"])
contract_definition_ids = Array[StringName]([&"contract_north_road_evacuation", &"contract_hold_stone_bridge"])
escalation_effects = Array[ExtResource("3_koqkg")]([SubResource("Resource_21121"), SubResource("Resource_m0i7p"), SubResource("Resource_1bicy")])
