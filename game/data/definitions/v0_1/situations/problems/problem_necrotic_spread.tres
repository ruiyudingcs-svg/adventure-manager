[resource]
script = ExtResource("4_ncirg")
id = &"problem_necrotic_spread"
title_key = &"problem.problem_necrotic_spread.title"
description_key = &"problem.problem_necrotic_spread.description"
problem_tags = Array[StringName]([&"necrotic_spread", &"forbidden_ritual"])
base_urgency = 60
age_urgency_per_week = 10
age_urgency_cap = 20
response_window_weeks = 3
urgency_rules = Array[ExtResource("5_j3hgg")]([SubResource("Resource_scynp"), SubResource("Resource_lr2if")])
activation_rules = Array[ExtResource("1_tuitg")]([SubResource("Resource_1ylih")])
resolution_rules = Array[ExtResource("1_tuitg")]([SubResource("Resource_gr3i4"), SubResource("Resource_yfpae"), SubResource("Resource_fp4hn")])
related_clock_ids = Array[StringName]([&"settlement_destruction", &"necrotic_corruption"])
contract_definition_ids = Array[StringName]([&"contract_investigate_necrotic_source", &"contract_disrupt_necrotic_ritual"])
escalation_effects = Array[ExtResource("3_ies7x")]([SubResource("Resource_5umdp"), SubResource("Resource_qxafn"), SubResource("Resource_3pv54")])
