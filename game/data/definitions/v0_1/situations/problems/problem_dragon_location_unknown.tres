reason_code = &"problem_dragon_location_unknown_settlement_destruction"

[sub_resource type="Resource" id="Resource_tovx4"]
script = ExtResource("2_82xpo")
type = &"modify_clock"
target_id = &"capture_preparation"
amount = -4
reason_code = &"problem_dragon_location_unknown_capture_preparation"

[sub_resource type="Resource" id="Resource_v54n3"]
script = ExtResource("3_7v1ac")
type = &"world_event_occurred"
target_id = &"event_dragon_lair_located"

[sub_resource type="Resource" id="Resource_0qwri"]
script = ExtResource("1_x10qi")
id = &"resolve_dragon_location_unknown_1"
