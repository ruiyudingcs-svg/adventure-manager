[resource]
script = ExtResource("4_klls8")
id = &"problem_dragon_location_unknown"
title_key = &"problem.problem_dragon_location_unknown.title"
description_key = &"problem.problem_dragon_location_unknown.description"
problem_tags = Array[StringName]([&"dragon_tracking", &"capture_research"])
base_urgency = 35
age_urgency_per_week = 5
age_urgency_cap = 15
response_window_weeks = 4
urgency_rules = Array[ExtResource("5_75ubu")]([SubResource("Resource_kdyyq"), SubResource("Resource_wfqja")])
resolution_rules = Array[ExtResource("1_x10qi")]([SubResource("Resource_0qwri")])
related_clock_ids = Array[StringName]([&"settlement_destruction", &"dragon_exhaustion", &"capture_preparation"])
contract_definition_ids = Array[StringName]([&"contract_locate_dragon_lair"])
escalation_effects = Array[ExtResource("2_82xpo")]([SubResource("Resource_5p7u6"), SubResource("Resource_ad3wv"), SubResource("Resource_tovx4")])
